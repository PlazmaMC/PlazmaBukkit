+    // Plazma start - Pufferfish Minecraft Changes
+    private boolean firstRunSpawnCounts = true;
+    private final java.util.concurrent.atomic.AtomicBoolean spawnCountsReady = new java.util.concurrent.atomic.AtomicBoolean(false);
+
+    private void handleMobSpawningAsync() {
+        for (ServerPlayer player : this.level.players()) {
+            // Paper start - per player mob spawning backoff
+            for (int j = 0; j < ServerPlayer.MOBCATEGORY_TOTAL_ENUMS; j++) {
+                player.mobCounts[j] = 0;
+
+                int newBackoff = player.mobBackoffCounts[j] - 1; // TODO make configurable bleed // TODO use nonlinear algorithm?
+                if (newBackoff < 0) {
+                    newBackoff = 0;
+                }
+                player.mobBackoffCounts[j] = newBackoff;
+            }
+            // Paper end - per player mob spawning backoff
+        }
+        if (firstRunSpawnCounts) {
+            firstRunSpawnCounts = false;
+            spawnCountsReady.set(true);
+        }
+
+        if (!spawnCountsReady.getAndSet(false)) return;
+        net.minecraft.server.MinecraftServer.getServer().mobSpawnExecutor.submit(() -> {
+            final int mapped = distanceManager.getNaturalSpawnChunkCount();
+            final ca.spottedleaf.moonrise.common.list.IteratorSafeOrderedReferenceSet.Iterator<Entity> entityIterator =
+                level.entityTickList.entities.iterator(ca.spottedleaf.moonrise.common.list.IteratorSafeOrderedReferenceSet.ITERATOR_FLAG_SEE_ADDITIONS);
+
+            try {
+                final org.plazmamc.plazma.util.IteratorIterable<Entity> entityIterable =
+                    new org.plazmamc.plazma.util.IteratorIterable<>(entityIterator);
+                lastSpawnState = NaturalSpawner.createState(mapped, this.level, entityIterable, this::getFullChunk, null, true);
+            } finally {
+                entityIterator.finishedIterating();
+            }
+            spawnCountsReady.set(true);
+        });
+    }
+    // Plazma end - Pufferfish Minecraft Changes
+
+    public static boolean asyncMobSpawning = false; // Plazma - Pufferfish Minecraft Changes
