+    private static final float SUFFOCATION_DAMAGE_AMOUNT = 1f;
+    public static boolean enableSuffocationOptimization = false;
+    public boolean shouldCheckForSuffocation() {
+        return !enableSuffocationOptimization || (this.tickCount % 10 == 0 && couldPossiblyBeHurt(SUFFOCATION_DAMAGE_AMOUNT));
+    }
