+    private static int loadedTick;
+
+    private int loadedLifetime = 0;
+
+    @Override
+    public void setPos(final double x, final double y, final double z) {
+        if (org.plazmamc.plazma.Options.global().entities.projectile.limitChunkLoading.enabled) {
+            int currentTick = net.minecraft.server.MinecraftServer.currentTick;
+            if (loadedTick != currentTick) {
+                loadedTick = currentTick;
+                loadedThisTick = 0;
+            }
+
+            int previousX = Mth.floor(this.getX()) >> 4,
+                previousZ = Mth.floor(this.getZ()) >> 4,
+                newX = Mth.floor(x) >> 4,
+                newZ = Mth.floor(z) >> 4;
+            if (
+                (previousX != newX || previousZ != newZ)
+                && ((net.minecraft.server.level.ServerChunkCache) this.level().getChunkSource()).getChunkAtIfCachedImmediately(newX, newZ) == null
+            ) {
+                if (loadedThisTick > org.plazmamc.plazma.Options.global().entities.projectile.limitChunkLoading.maxChunkLoadsPerTick) {
+                    if (++this.loadedLifetime > org.plazmamc.plazma.Options.global().entities.projectile.limitChunkLoading.maxChunkLoadsPerProjectile) {
+                        this.discard();
+                    }
+                    return;
+                }
+                loadedThisTick++;
+            }
+        }
+        super.setPos(x, y, z);
+    }
