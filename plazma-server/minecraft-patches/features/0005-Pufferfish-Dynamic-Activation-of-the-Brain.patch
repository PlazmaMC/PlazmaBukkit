     private @Nullable LivingEntity target;
     private final Sensing sensing;
     private DropChances dropChances = DropChances.DEFAULT;
@@ -227,10 +233,11 @@ public abstract class Mob extends LivingEntity implements Targeting, EquipmentUs
         super.inactiveTick();
         if (!this.aware) return; // Paper - Do not tick AI for inactive unaware mobs
         final boolean isThrottled = this.level().paperConfig().entities.behavior.inactiveMobGoalSelectorThrottleRate.enabled() && inactiveTickDisableCounter++ % this.level().paperConfig().entities.behavior.inactiveMobGoalSelectorThrottleRate.intValue() != 0; // Paper - Throttle inactive goal selector ticking
-        if (this.goalSelector.inactiveTick() && !isThrottled) {
+        final boolean dabEnabled = this.level().plazmaConfig().entities.dab.enabled && this.getType().enableDAB; // Plazma - (Pufferfish) Dynamic Activation of the Brain
+        if (this.goalSelector.inactiveTick(dabEnabled, true, this.activatedPriority) && !isThrottled) { // Plazma - (Pufferfish) Dynamic Activation of the Brain
             this.goalSelector.tick();
         }
-        if (this.targetSelector.inactiveTick()) {
+        if (this.targetSelector.inactiveTick(dabEnabled, true, this.activatedPriority)) { // Plazma - (Pufferfish) Dynamic Activation of the Brain
             this.targetSelector.tick();
         }
     }
@@ -855,19 +862,20 @@ public abstract class Mob extends LivingEntity implements Targeting, EquipmentUs
         this.sensing.tick();
         profiler.pop();
         int idBasedTickCount = this.tickCount + this.getId();
+        final boolean dabEnabled = this.level().plazmaConfig().entities.dab.enabled && this.getType().enableDAB; // Plazma - (Pufferfish) Dynamic Activation of the Brain
         if (idBasedTickCount % 2 != 0 && this.tickCount > 1) {
             profiler.push("targetSelector");
-            this.targetSelector.tickRunningGoals(false);
+            if (this.targetSelector.inactiveTick(dabEnabled, false, this.activatedPriority)) this.targetSelector.tickRunningGoals(false); // Plazma - (Pufferfish) Dynamic Activation of the Brain
             profiler.pop();
             profiler.push("goalSelector");
-            this.goalSelector.tickRunningGoals(false);
+            if (this.goalSelector.inactiveTick(dabEnabled, false, this.activatedPriority)) this.goalSelector.tickRunningGoals(false); // Plazma - (Pufferfish) Dynamic Activation of the Brain
             profiler.pop();
         } else {
             profiler.push("targetSelector");
-            this.targetSelector.tick();
+            if (this.targetSelector.inactiveTick(dabEnabled, false, this.activatedPriority)) this.targetSelector.tick(); // Plazma - (Pufferfish) Dynamic Activation of the Brain
             profiler.pop();
             profiler.push("goalSelector");
-            this.goalSelector.tick();
+            if (this.goalSelector.inactiveTick(dabEnabled, false, this.activatedPriority)) this.goalSelector.tick(); // Plazma - (Pufferfish) Dynamic Activation of the Brain
             profiler.pop();
         }
 
