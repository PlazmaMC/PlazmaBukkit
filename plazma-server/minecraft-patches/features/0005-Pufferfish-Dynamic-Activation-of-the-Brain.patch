diff --git a/io/papermc/paper/entity/activation/ActivationRange.java b/io/papermc/paper/entity/activation/ActivationRange.java
index 829f7685904fd741e00403647ae76d32275c34a3..1a59ffee90c183406f07c3c4d78dda3770db1471 100644
--- a/io/papermc/paper/entity/activation/ActivationRange.java
+++ b/io/papermc/paper/entity/activation/ActivationRange.java
@@ -166,6 +166,25 @@ public final class ActivationRange {
                 }
 
                 ActivationRange.activateEntity(entity);
+
+                // Plazma start - (Pufferfish) Dynamic Activation of the Brain
+                if (entity instanceof Mob mob) {
+                    if (mob.getType().enableDAB && mob.level().plazmaConfig().entities.dab.enabled
+                        && (!mob.isInWater() || !mob.level().plazmaConfig().entities.dab.disableInWater || !mob.is(net.minecraft.tags.EntityTypeTags.CAN_BREATHE_UNDER_WATER))
+                    ) {
+                        if (!mob.activatedPriorityReset) {
+                            mob.activatedPriorityReset = true;
+                            mob.activatedPriority = mob.level().plazmaConfig().entities.dab.maxTickFrequency;
+                        }
+                        final int squaredDistance = (int) mob.distanceToSqr(player);
+                        mob.activatedPriority = squaredDistance > mob.level().plazmaConfig().entities.dab.startDistanceSquared
+                            ? (byte) Math.clamp(squaredDistance >> mob.level().plazmaConfig().entities.dab.distanceModifier, 1, mob.activatedPriority)
+                            : 1;
+                    } else {
+                        mob.activatedPriority = 1;
+                    }
+                }
+                // Plazma end - (Pufferfish) Dynamic Activation of the Brain
             }
         }
     }
