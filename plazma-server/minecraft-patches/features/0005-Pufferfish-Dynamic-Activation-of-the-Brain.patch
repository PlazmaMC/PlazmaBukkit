@@ -36,7 +36,8 @@ public class VillagerPanicTrigger extends Behavior<Villager> {
 
     @Override
     protected void tick(final ServerLevel level, final Villager body, final long timestamp) {
-        if (timestamp % 100L == 0L) {
+        if (--body.nextGolemPanic < 0) { // Plazma - (Pufferfish) Dynamic Activation of the Brain (Use own counter to honor the maxTickFrequency)
+            body.nextGolemPanic = 100; // Plazma - (Pufferfish) Dynamic Activation of the Brain (Use own counter to honor the maxTickFrequency)
             body.spawnGolemIfNeeded(level, timestamp, 3);
         }
     }
