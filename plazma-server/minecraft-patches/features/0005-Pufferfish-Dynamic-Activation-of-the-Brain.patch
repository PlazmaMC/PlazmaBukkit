     public GoalSelector targetSelector;
+    // Plazma start - (Pufferfish) Dynamic Activation of the Brain
+    public static byte DEFAULT_ACTIVATED_PRIORITY = 20;
+    public boolean activatedPriorityReset = false;
+    public byte activatedPriority;
+    protected int behaviorTick = 0;
